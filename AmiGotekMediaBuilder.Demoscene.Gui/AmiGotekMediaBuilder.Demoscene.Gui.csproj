<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AmiGotekMediaBuilder.Core\AmiGotekMediaBuilder.Core.csproj" />
    <ProjectReference Include="..\AmiGotekMediaBuilder.Demoscene\AmiGotekMediaBuilder.Demoscene.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <!--
      Avalonia's build-time telemetry task writes to the user's global
      AvaloniaUI folder.  Keep this project buildable in restricted/CI
      environments (and avoid collecting telemetry for this open-source app).
      An empty value prevents the AvaloniaStats target from running.
    -->
    <UsedAvaloniaProducts></UsedAvaloniaProducts>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\Fonts\MatrixTypeDisplay-Regular.ttf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.18" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.18" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.18" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.18" />
  </ItemGroup>

</Project>
